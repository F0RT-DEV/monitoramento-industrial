# Variáveis de ambiente do simulador (todas opcionais).
# Sem elas, valem os valores do config.json.
 
# URL da API
API_URL=http://localhost:3000
 
# Segundos entre um ciclo e outro
INTERVALO=2
 
# Quantas máquinas simular (vazio = todas)
NUM_MAQUINAS=
 
# Quantos ciclos rodar (0 = até apertar Ctrl+C)
CICLOS=10